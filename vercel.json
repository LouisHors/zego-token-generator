{
    "version": 2,
    "builds": [
        {
            "src": "server/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/style/(.*)",
            "dest": "/style/$1"
        },
        {
            "src": "/page/(.*)",
            "dest": "/page/$1"
        },
        {
            "src": "/(.*)",
            "dest": "server/server.js"
        }
    ]
}
