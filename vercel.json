{
    "version": 2,
    "builds": [
        {
            "src": "server/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/style/(.*)"
        },
        {
            "src": "/page/(.*)"
        },
        {
            "src": "/(.*)",
            "dest": "server/server.js"
        }
    ]
}
